+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import type { ChatNode } from '../src/client/contract/chat-nodes.ts'
+import type { ChatViewSlotProps } from '../src/client/contract/slots.ts'
+import { ActivityCluster } from '../src/client/chat/ActivityCluster.tsx'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(zh, commonZh)
+
+function nodes(): readonly ChatNode[] {
+  const location = {
+    kind: 'step' as const,
+    turn: { turn: 1 },
+    step: { turn: 1, step: 1 },
+  }
+  return [
+    {
+      key: 'assistant',
+      kind: 'assistant-step',
+      location,
+      data: {
+        status: 'settled',
+        turn: 1,
+        step: 1,
+        time: 1,
+        blocks: [{ kind: 'reasoning', text: 'Inspect the files' }],
+      },
+    },
+    {
+      key: 'tool',
+      kind: 'tool-call',
+      location,
+      data: {
+        root: {
+          kind: 'tool-result',
+          seq: 2,
+          time: 2,
+          callId: 'call-1',
+          call: { name: 'read', argsRaw: '{"file_path":"README.md"}' },
+          callTime: 1,
+          content: [{ type: 'text', text: 'file body' }],
+          isError: false,
+          callView: null,
+          resultView: null,
+          subCalls: [],
+        },
+      },
+    },
+  ] as unknown as readonly ChatNode[]
+}
+
+function props(inspectCall: (callId: string) => void = () => {}) {
+  const activityNodes = nodes()
+  const byKey = new Map(activityNodes.map(node => [node.key, node]))
+  const snapshot = { chat: { nodes: { get: (key: string) => byKey.get(key) } } }
+  const useSession = ((selector: (value: typeof snapshot) => unknown) => selector(snapshot)) as ChatViewSlotProps['useSession']
+  const renderSlot = ((key: string, owner: { text?: string; toolName?: string }) => key.endsWith('reasoningDetail')
+    ? <div>Reasoning detail: {owner.text}</div>
+    : <div>Tool detail: {owner.toolName}</div>) as ChatViewSlotProps['renderSlot']
+  return {
+    nodeKeys: ['assistant', 'tool'],
+    useSession,
+    renderSlot,
+    openFile: () => {},
+    inspectCall,
+    t,
+  }
+}
+
+describe('ActivityCluster', () => {
+  it('shows icons first, switches one inline panel, and preserves side inspection', () => {
+    const inspectCall = vi.fn()
+    const view = render(<ActivityCluster {...props(inspectCall)} />)
+    const think = view.getByRole('button', { name: 'Think' })
+    const read = view.getByRole('button', { name: 'read' })
+    expect(view.queryByLabelText('活动详情')).toBeNull()
+
+    fireEvent.click(think)
+    expect(view.getByText('Reasoning detail: Inspect the files')).toBeTruthy()
+    expect(think.getAttribute('aria-expanded')).toBe('true')
+
+    fireEvent.click(read)
+    expect(view.queryByText('Reasoning detail: Inspect the files')).toBeNull()
+    expect(view.getByText('Tool detail: read')).toBeTruthy()
+    expect(read.getAttribute('aria-expanded')).toBe('true')
+    expect(view.getAllByLabelText('活动详情')).toHaveLength(1)
+
+    fireEvent.click(view.getByRole('button', { name: '在右侧详情中打开' }))
+    expect(inspectCall).toHaveBeenCalledWith('call-1')
+  })
+})
diff --git a/packages/client/ui-conversation/tests/activity-groups.client.spec.ts b/packages/client/ui-conversation/tests/activity-groups.client.spec.ts
