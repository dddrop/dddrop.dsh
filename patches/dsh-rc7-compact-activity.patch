@@ -0,0 +1,256 @@
+import { useEffect, useId, useMemo, useState, type ReactNode } from 'react'
+import type { ToolCallBlock } from '@deepseek-ai/dsh-client-runtime/client'
+import {
+  IconBrowseOutline16, IconChecklistOutline14, IconCodeOutline16,
+  IconCordisPluginOutline14, IconDataOutline16, IconEditOutline16,
+  IconGlobeOutline14, IconInspectOutline12, IconQuestionOutline14, IconSearchOutline16,
+  IconSkillOutline16, IconThinkOutline16, MarkdownText,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import type { ChatViewSlotProps } from '../contract/slots.ts'
+import type { ChatNode } from '../contract/chat-nodes.ts'
+import css from './ActivityCluster.module.css'
+
+type ActivityState = 'running' | 'ok' | 'error'
+
+interface ReasoningActivity {
+  kind: 'reasoning'
+  id: string
+  label: string
+  text: string
+  running: boolean
+  state: ActivityState
+}
+
+interface ToolActivity {
+  kind: 'tool'
+  id: string
+  label: string
+  callId: string
+  toolName: string
+  block: ToolCallBlock
+  argsRaw: string
+  state: ActivityState
+}
+
+type ActivityItem = ReasoningActivity | ToolActivity
+
+interface ActivityClusterProps {
+  nodeKeys: readonly string[]
+  useSession: ChatViewSlotProps['useSession']
+  renderSlot: ChatViewSlotProps['renderSlot']
+  cwd?: string | undefined
+  openFile: ChatViewSlotProps['openFile']
+  inspectCall: ChatViewSlotProps['inspectCall']
+  t: ChatViewSlotProps['t']
+}
+
+function sameNodeRefs(left: readonly (ChatNode | undefined)[], right: readonly (ChatNode | undefined)[]): boolean {
+  return left.length === right.length && left.every((node, index) => node === right[index])
+}
+
+function callName(block: ToolCallBlock): string {
+  if ('kind' in block) return block.call?.name ?? block.callId
+  return block.name
+}
+
+function callArgs(block: ToolCallBlock): string {
+  if ('kind' in block) return block.call?.argsRaw ?? ''
+  return block.argsRaw
+}
+
+function callState(block: ToolCallBlock): ActivityState {
+  if (!('kind' in block)) return 'running'
+  return block.isError ? 'error' : 'ok'
+}
+
+function appendTool(items: ActivityItem[], nodeKey: string, block: ToolCallBlock): void {
+  const toolName = callName(block)
+  items.push({
+    kind: 'tool',
+    id: `${nodeKey}:tool:${block.callId}`,
+    label: toolName,
+    callId: block.callId,
+    toolName,
+    block,
+    argsRaw: callArgs(block),
+    state: callState(block),
+  })
+  for (const child of block.subCalls) appendTool(items, nodeKey, child)
+}
+
+function collectActivities(nodes: readonly (ChatNode | undefined)[]): readonly ActivityItem[] {
+  const items: ActivityItem[] = []
+  for (const node of nodes) {
+    if (node?.kind === 'assistant-step') {
+      const last = node.data.blocks.length - 1
+      node.data.blocks.forEach((block, index) => {
+        if (block.kind !== 'reasoning') return
+        const running = node.data.status === 'running' && index === last
+        items.push({
+          kind: 'reasoning',
+          id: `${node.key}:reasoning:${index}`,
+          label: 'Think',
+          text: block.text,
+          running,
+          state: running ? 'running' : 'ok',
+        })
+      })
+      continue
+    }
+    if (node?.kind === 'tool-call') appendTool(items, node.key, node.data.root)
+  }
+  return items
+}
+
+function toolGlyph(name: string): ReactNode {
+  if (name === 'grep' || name === 'glob' || name.includes('search')) return <IconSearchOutline16 size={15} />
+  if (name === 'read') return <IconBrowseOutline16 size={15} />
+  if (name === 'edit' || name === 'write') return <IconEditOutline16 size={15} />
+  if (name === 'bash' || name.includes('command')) return <IconCodeOutline16 size={15} />
+  if (name.startsWith('cordis_')) return <IconCordisPluginOutline14 size={15} />
+  if (name.startsWith('web_')) return <IconGlobeOutline14 size={15} />
+  if (name === 'todo_write') return <IconChecklistOutline14 size={15} />
+  if (name === 'skill') return <IconSkillOutline16 size={15} />
+  if (name === 'ask_user_question') return <IconQuestionOutline14 size={15} />
+  const initials = name.split(/[_-]/u).filter(Boolean).slice(0, 2).map(part => part[0]).join('')
+  return initials === '' ? <IconDataOutline16 size={15} /> : <span className={css.initials}>{initials}</span>
+}
+
+function flattenedResult(block: ToolCallBlock): string {
+  if (!('kind' in block)) return ''
+  const parts: string[] = []
+  for (const item of block.content) {
+    if (item.type === 'text') parts.push(item.text)
+  }
+  return parts.join('\n')
+}
+
+function ActivityIcon({ item, selected, panelId, onSelect }: {
+  item: ActivityItem
+  selected: boolean
+  panelId: string
+  onSelect: () => void
+}) {
+  return (
+    <button
+      type="button"
+      className={css.chip}
+      aria-label={item.label}
+      aria-expanded={selected}
+      aria-controls={panelId}
+      title={item.label}
+      data-activity-kind={item.kind}
+      data-activity-state={item.state}
+      data-chat-anchor-key={item.kind === 'tool' ? `call:${item.callId}` : undefined}
+      data-chat-call-id={item.kind === 'tool' ? item.callId : undefined}
+      onClick={onSelect}
+    >
+      {item.kind === 'reasoning' ? <IconThinkOutline16 size={15} /> : toolGlyph(item.toolName)}
+      <span className={css.status} data-state={item.state} aria-hidden />
+    </button>
+  )
+}
+
+function ToolFallback({ item, runningLabel }: { item: ToolActivity; runningLabel: string }) {
+  const output = flattenedResult(item.block)
+  if (item.state === 'running') return <div className={css.detailMeta}>{runningLabel}</div>
+  return <pre className={css.code}>{output}</pre>
+}
+
+/** Compact one Turn's reasoning and Tool activity into a horizontal icon strip. */
+export function ActivityCluster({
+  nodeKeys, useSession, renderSlot, cwd, openFile, inspectCall, t,
+}: ActivityClusterProps) {
+  const nodes = useSession(
+    snapshot => nodeKeys.map(key => snapshot.chat.nodes.get(key) as ChatNode | undefined),
+    sameNodeRefs,
+  )
+  const items = useMemo(() => collectActivities(nodes), [nodes])
+  const codeLabels = useMemo(() => ({ copyLabel: t('copy'), copiedLabel: t('copied') }), [t])
+  const [selectedId, setSelectedId] = useState<string | null>(null)
+  const panelId = useId()
+  const selected = items.find(item => item.id === selectedId) ?? null
+
+  useEffect(() => {
+    if (selectedId !== null && !items.some(item => item.id === selectedId)) setSelectedId(null)
+  }, [items, selectedId])
+
+  let detailBody: ReactNode = null
+  if (selected?.kind === 'reasoning') {
+    detailBody = renderSlot('conversation.chat.activity.reasoningDetail', {
+      text: selected.text,
+      running: selected.running,
+    }, {
+      fallback: (
+        <div className={css.reasoning}>
+          <MarkdownText text={selected.text} streaming={selected.running} codeLabels={codeLabels} />
+        </div>
+      ),
+    })
+  } else if (selected?.kind === 'tool') {
+    detailBody = (
+      <>
+        {selected.argsRaw !== '' ? (
+          <>
+            <div className={css.inputLabel}>{t('details.input')}</div>
+            <pre className={css.code}>{selected.argsRaw}</pre>
+            <div className={css.inputLabel}>{t('details.output')}</div>
+          </>
+        ) : null}
+        {renderSlot('conversation.chat.activity.toolDetail', {
+          callId: selected.callId,
+          toolName: selected.toolName,
+          block: selected.block,
+          cwd,
+          openFile,
+          inspect: () => { inspectCall(selected.callId) },
+        }, {
+          fallback: <ToolFallback item={selected} runningLabel={t('details.running')} />,
+        })}
+      </>
+    )
+  }
+
+  const statusLabel = selected?.state === 'running'
+    ? t('row.running')
+    : selected?.state === 'error' ? t('row.failed') : ''
+
+  if (items.length === 0) return null
+  return (
+    <div className={css.root} data-chat-activity-cluster="">
+      <div className={css.strip} role="toolbar" aria-label={t('activity.label')}>
+        {items.map(item => (
+          <ActivityIcon
+            key={item.id}
+            item={item}
+            selected={item.id === selectedId}
+            panelId={panelId}
+            onSelect={() => { setSelectedId(current => current === item.id ? null : item.id) }}
+          />
+        ))}
+      </div>
+      {selected !== null ? (
+        <section id={panelId} className={css.detail} aria-label={t('activity.details')}>
+          <div className={css.detailHeader}>
+            <span>{selected.label}</span>
+            <span className={css.detailActions}>
+              <span className={css.detailMeta}>{statusLabel}</span>
+              {selected.kind === 'tool' ? (
+                <button
+                  type="button"
+                  className={css.detailAction}
+                  aria-label={t('activity.inspect')}
+                  title={t('activity.inspect')}
+                  onClick={() => { inspectCall(selected.callId) }}
+                >
+                  <IconInspectOutline12 size={14} />
+                </button>
+              ) : null}
+            </span>
+          </div>
+          {detailBody}
+        </section>
+      ) : null}
+    </div>
+  )
+}
