diff --git a/packages/client/ui-conversation/src/client/chat/activity-groups.ts b/packages/client/ui-conversation/src/client/chat/activity-groups.ts
new file mode 100644
index 0000000000..0d496f4462
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/chat/activity-groups.ts
@@ -0,0 +1,79 @@
+import type { ChatNode } from '../contract/chat-nodes.ts'
+
+export interface ActivityGroupUnit {
+  kind: 'activity'
+  key: string
+  nodeKeys: readonly string[]
+  groupKey: string
+}
+
+export interface ChatNodeUnit {
+  kind: 'node'
+  key: string
+  nodeKey: string
+}
+
+export type ChatFlowUnit = ActivityGroupUnit | ChatNodeUnit
+
+type NodeLookup = (key: string) => ChatNode | undefined
+
+function isReasoningOnlyAssistant(node: ChatNode): boolean {
+  if (node.kind !== 'assistant-step') return false
+  let hasReasoning = false
+  for (const block of node.data.blocks) {
+    if (block.kind === 'reasoning') {
+      hasReasoning = true
+      continue
+    }
+    if (block.kind !== 'tool-call') return false
+  }
+  return hasReasoning
+}
+
+/** Return the owning Turn for nodes that the compact activity surface may claim. */
+export function activityGroupKey(node: ChatNode): string | null {
+  if (node.kind !== 'tool-call' && !isReasoningOnlyAssistant(node)) return null
+  if (node.location.kind !== 'step') return null
+  return `turn:${node.location.step.turn}`
+}
+
+/**
+ * Track only grouping-relevant node facts. Streaming text and Tool settlement
+ * do not rebuild the whole Chat list; a new activity member or changed block
+ * classification does.
+ */
+export function activityMembershipSignature(order: readonly string[], lookup: NodeLookup): string {
+  return order.map((key) => {
+    const node = lookup(key)
+    if (node === undefined) return `${key}:missing`
+    return `${key}:${activityGroupKey(node) ?? 'node'}`
+  }).join('|')
+}
+
+/** Group consecutive reasoning-only Assistant and Tool nodes in the same Turn. */
+export function groupActivityOrder(order: readonly string[], lookup: NodeLookup): readonly ChatFlowUnit[] {
+  const units: ChatFlowUnit[] = []
+  for (const nodeKey of order) {
+    const node = lookup(nodeKey)
+    const activityKey = node === undefined ? null : activityGroupKey(node)
+    if (activityKey === null) {
+      units.push({ kind: 'node', key: nodeKey, nodeKey })
+      continue
+    }
+    const previous = units.at(-1)
+    if (previous?.kind === 'activity' && previous.groupKey === activityKey) {
+      units[units.length - 1] = {
+        ...previous,
+        nodeKeys: [...previous.nodeKeys, nodeKey],
+      }
+      continue
+    }
+    units.push({
+      kind: 'activity',
+      key: `activity:${nodeKey}`,
+      nodeKeys: [nodeKey],
+      groupKey: activityKey,
+    })
+  }
+  return units
+}
