@@ -0,0 +1,97 @@
+import { describe, expect, it } from 'vitest'
+import type { ChatNode } from '../src/client/contract/chat-nodes.ts'
+import { activityMembershipSignature, groupActivityOrder } from '../src/client/chat/activity-groups.ts'
+
+function stepLocation(turn: number, step: number) {
+  return {
+    kind: 'step' as const,
+    turn: { turn },
+    step: { turn, step },
+  }
+}
+
+function assistant(key: string, turn: number, step: number, kinds: readonly ('reasoning' | 'text' | 'tool-call')[]): ChatNode {
+  return {
+    key,
+    kind: 'assistant-step',
+    location: stepLocation(turn, step),
+    data: {
+      status: 'settled',
+      turn,
+      step,
+      time: 1,
+      blocks: kinds.map(kind => kind === 'reasoning'
+        ? { kind, text: 'reasoning' }
+        : kind === 'text'
+          ? { kind, text: 'answer' }
+          : { kind, callId: 'call-1', name: 'read', argsRaw: '{}' }),
+    },
+  } as unknown as ChatNode
+}
+
+function tool(key: string, turn: number, step: number): ChatNode {
+  return {
+    key,
+    kind: 'tool-call',
+    location: stepLocation(turn, step),
+    data: {
+      root: {
+        callId: key,
+        name: 'read',
+        argsRaw: '{}',
+        turn,
+        step,
+        time: 1,
+        callView: null,
+        subCalls: [],
+      },
+    },
+  } as unknown as ChatNode
+}
+
+function lookup(nodes: readonly ChatNode[]): (key: string) => ChatNode | undefined {
+  const byKey = new Map(nodes.map(node => [node.key, node]))
+  return key => byKey.get(key)
+}
+
+describe('compact activity grouping', () => {
+  it('groups consecutive reasoning-only Assistant and Tool nodes in one Turn', () => {
+    const nodes = [assistant('assistant', 1, 2, ['reasoning', 'tool-call']), tool('tool', 1, 2)]
+    expect(groupActivityOrder(nodes.map(node => node.key), lookup(nodes))).toEqual([{
+      kind: 'activity',
+      key: 'activity:assistant',
+      nodeKeys: ['assistant', 'tool'],
+      groupKey: 'turn:1',
+    }])
+  })
+
+  it('keeps visible Assistant prose on the ordinary renderer path', () => {
+    const nodes = [assistant('assistant', 1, 2, ['reasoning', 'text']), tool('tool', 1, 2)]
+    expect(groupActivityOrder(nodes.map(node => node.key), lookup(nodes))).toEqual([
+      { kind: 'node', key: 'assistant', nodeKey: 'assistant' },
+      { kind: 'activity', key: 'activity:tool', nodeKeys: ['tool'], groupKey: 'turn:1' },
+    ])
+  })
+
+  it('compacts consecutive activity across Step boundaries in one Turn', () => {
+    const nodes = [tool('first', 1, 1), tool('second', 1, 2)]
+    expect(groupActivityOrder(nodes.map(node => node.key), lookup(nodes))).toEqual([{
+      kind: 'activity',
+      key: 'activity:first',
+      nodeKeys: ['first', 'second'],
+      groupKey: 'turn:1',
+    }])
+  })
+
+  it('does not merge activity across Turn boundaries', () => {
+    const nodes = [tool('first', 1, 1), tool('second', 2, 1)]
+    expect(groupActivityOrder(nodes.map(node => node.key), lookup(nodes))).toHaveLength(2)
+  })
+
+  it('changes membership signature only when grouping facts change', () => {
+    const reasoning = assistant('assistant', 1, 2, ['reasoning'])
+    const visible = assistant('assistant', 1, 2, ['text'])
+    expect(activityMembershipSignature(['assistant'], lookup([reasoning])))
+      .not.toBe(activityMembershipSignature(['assistant'], lookup([visible])))
+  })
+})
