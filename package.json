{
  "name": "@dddrop/dsh-configuration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Version-controlled DeepSeek Harness plugins, agent presets, and profile configuration.",
  "scripts": {
    "build": "node plugins/theme-blue/scripts/build-client.mjs && node plugins/kanban/scripts/build-client.mjs",
    "setup": "node scripts/install.mjs",
    "link:presets": "node scripts/link-presets.mjs",
    "sync:profile": "node scripts/sync-profile.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/doctor.mjs --strict && node --test tests/*.test.mjs plugins/*/test/*.test.mjs",
    "test": "node --test tests/*.test.mjs plugins/*/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
